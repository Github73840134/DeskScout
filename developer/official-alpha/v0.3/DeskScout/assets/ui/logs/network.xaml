<Page 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      >
	<ScrollViewer>
		<StackPanel>
			
			<Button Name="settings.back" Content="Back" />
			<TextBlock Text="Network Logs" FontSize="60" />
			<ComboBox Name="logs.logselect" Height="32" Padding="6,4" FontSize="13">
				<ComboBoxItem Content="Service" IsSelected="True" />
			</ComboBox>
			<TextBox Name="logs.logdata" Text="TextBox" AcceptsReturn="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" />
		</StackPanel>
	</ScrollViewer>
</Page>
