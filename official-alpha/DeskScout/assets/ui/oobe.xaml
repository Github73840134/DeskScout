<Page 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
     >
    <Grid>
        <Image Opacity="0" Name="Background" Stretch="Fill" Source="../assets/background.png"/>

        <StackPanel Opacity="1" Name="Loader" Orientation="Vertical" VerticalAlignment="Center">
           <ProgressRing IsActive="True"/>
        </StackPanel>

        <StackPanel Opacity="1" Name="Text" Orientation="Vertical" VerticalAlignment="Center">
            
            <TextBlock Opacity="0" Name="Title" Text="DeskScout" FontSize="60" TextAlignment="Center" />
            <TextBlock Opacity="0" Name="Description" Text="A simple app to bridge the gap between Dexcom, Windows, and Nighstscout" FontSize="14" TextAlignment="Center"/>
            <Border BorderThickness="1" Height="16" />
            <Button Opacity="0" Name="oobe.next" Content="Lets Go" HorizontalAlignment="Center" />
        
        </StackPanel>
        <Button Name="oobe.restore" Opacity="0" Content="Restore Settings" HorizontalAlignment="Right" VerticalAlignment="Bottom" />

    </Grid>
</Page>
