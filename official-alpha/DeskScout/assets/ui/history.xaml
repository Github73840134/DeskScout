<Page  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Frame>
            
        <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Glucose History" FontSize="48" />
            <ComboBox Name="DatePicker" />
            <TextBlock Text="Overview" FontSize="36"/>
            <Image Name="Graph" Stretch="Fill" Source=""/>
            <InfoBar Name="GapDisclaimer" IsOpen="False" Severity="Informational" Title="Missing Data" IsClosable="False" Message="There is gaps in your graph. Insights, predictions, and averages may not be correct" />

            <InfoBar Name="LowDataDisclaimer" IsOpen="False" Severity="Informational" Title="Too Little Data" IsClosable="False" Message="Insights, predictions, and averages will not be correct" />
            <StackPanel Orientation="Horizontal">
                
                <TextBlock Name="DailyAverage" Text="" FontSize="24"/>
                <TextBlock Name="Readings" Text="" FontSize="12"/>
             </StackPanel>
            <StackPanel Name="History" Orientation="Vertical">
            </StackPanel>
         </StackPanel>
        </ScrollViewer>
    </Frame>
</Page>